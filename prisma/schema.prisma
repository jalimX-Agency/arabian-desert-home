generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Suite {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  tagline           String
  description       String
  longDescription   String
  price             Int
  originalPrice     Int?
  childPricePercent Int       @default(50)
  currency          String    @default("MAD")
  features          String
  amenities         String
  image             String
  images            String
  maxGuests         Int       @default(2)
  maxChildren       Int       @default(2)
  bedType           String
  size              String
  hasAC             Boolean   @default(false)
  order             Int       @default(0)
  featured          Boolean   @default(false)
  type              String    @default("suite")
  nameEn            String    @default("")
  taglineEn         String    @default("")
  descriptionEn     String    @default("")
  longDescriptionEn String    @default("")
  featuresEn        String    @default("")
  amenitiesEn       String    @default("")
  nameEs            String    @default("")
  taglineEs         String    @default("")
  descriptionEs     String    @default("")
  longDescriptionEs String    @default("")
  featuresEs        String    @default("")
  amenitiesEs       String    @default("")
  nameIt            String    @default("")
  taglineIt         String    @default("")
  descriptionIt     String    @default("")
  longDescriptionIt String    @default("")
  featuresIt        String    @default("")
  amenitiesIt       String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookings          Booking[]
  seasonalPrices    SeasonalPrice[]
  closures          TentClosure[]
  devisItems        DevisItem[]
}

model Activity {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  description       String
  longDescription   String
  duration          String
  price             Int
  originalPrice     Int?
  childPricePercent Int       @default(50)
  currency          String    @default("MAD")
  image             String
  category          String
  includes          String
  schedule          String
  transportIncluded Boolean   @default(false)
  order             Int       @default(0)
  featured          Boolean   @default(false)
  nameEn            String    @default("")
  descriptionEn     String    @default("")
  longDescriptionEn String    @default("")
  includesEn        String    @default("")
  nameEs            String    @default("")
  descriptionEs     String    @default("")
  longDescriptionEs String    @default("")
  includesEs        String    @default("")
  nameIt            String    @default("")
  descriptionIt     String    @default("")
  longDescriptionIt String    @default("")
  includesIt        String    @default("")
  images            String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookings          Booking[]
  seasonalPrices    SeasonalPrice[]
  devisItems        DevisItem[]
}

model DayPass {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  description       String
  price             Int
  originalPrice     Int?
  childPricePercent Int       @default(50)
  currency          String    @default("MAD")
  includes          String
  image             String    @default("")
  order             Int       @default(0)
  nameEn            String    @default("")
  descriptionEn     String    @default("")
  includesEn        String    @default("")
  nameEs            String    @default("")
  descriptionEs     String    @default("")
  includesEs        String    @default("")
  nameIt            String    @default("")
  descriptionIt     String    @default("")
  includesIt        String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookings          Booking[]
  seasonalPrices    SeasonalPrice[]
  devisItems        DevisItem[]
}

model DiningVenue {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String
  longDescription    String
  image             String
  capacity          String?
  order             Int      @default(0)
  nameEn            String   @default("")
  descriptionEn     String   @default("")
  longDescriptionEn String   @default("")
  nameEs            String   @default("")
  descriptionEs     String   @default("")
  longDescriptionEs String   @default("")
  nameIt            String   @default("")
  descriptionIt     String   @default("")
  longDescriptionIt String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SpaTreatment {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  duration    String
  price       Int
  currency    String   @default("MAD")
  image       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One order placed by a guest — can bundle several Bookings (e.g. a tent
// stay + an activity) under one contact record, total and access link.
model Reservation {
  id          String    @id @default(cuid())
  accessToken String    @unique @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String
  specialReqs String?
  channel     String    @default("website")
  totalAmount Int
  currency    String    @default("MAD")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  items       Booking[]
  devis       Devis?
}

model Booking {
  id            String       @id @default(cuid())
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  email         String
  phone         String?
  serviceType   String    @default("suite")
  suiteId     String?
  suite       Suite?    @relation(fields: [suiteId], references: [id])
  activityId  String?
  activity    Activity? @relation(fields: [activityId], references: [id])
  dayPassId   String?
  dayPass     DayPass?  @relation(fields: [dayPassId], references: [id])
  checkIn     DateTime?
  checkOut    DateTime?
  date        DateTime?
  quantity    Int       @default(1)
  guests      Int       @default(2)
  children    Int       @default(0)
  experiences String?
  specialReqs String?
  status      String    @default("pending")
  totalAmount Int
  currency    String    @default("MAD")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SeasonalPrice {
  id          String    @id @default(cuid())
  label       String
  startDate   DateTime
  endDate     DateTime
  price       Int
  suiteId     String?
  suite       Suite?    @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  activityId  String?
  activity    Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  dayPassId   String?
  dayPass     DayPass?  @relation(fields: [dayPassId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/** A period during which a tent type is closed for booking (maintenance, private use, etc). */
model TentClosure {
  id        String   @id @default(cuid())
  label     String
  startDate DateTime
  endDate   DateTime
  suiteId   String
  suite     Suite    @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  location  String
  rating    Int      @default(5)
  source    String   @default("general")
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  alt       String   @default("")
  altEn     String   @default("")
  altEs     String   @default("")
  altIt     String   @default("")
  caption   String   @default("")
  captionEn String   @default("")
  captionEs String   @default("")
  captionIt String   @default("")
  category  String   @default("general")
  order     Int      @default(0)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String   @default("")
  content   String   @default("")
  image     String   @default("")
  category  String   @default("")
  author    String   @default("")
  featured  Boolean  @default(false)
  order     Int      @default(0)
  titleEn   String   @default("")
  excerptEn String   @default("")
  contentEn String   @default("")
  titleEs   String   @default("")
  excerptEs String   @default("")
  contentEs String   @default("")
  titleIt   String   @default("")
  excerptIt String   @default("")
  contentIt String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A quote sent to a client before it becomes a Reservation. Carries its own access
// token so the client can accept or refuse it from a private link, and keeps the
// quoted amounts frozen — converting never re-prices what was promised.
model Devis {
  id            String      @id @default(cuid())
  reference     String      @unique
  accessToken   String      @unique @default(cuid())
  status        String      @default("draft") // draft|sent|accepted|refused|expired|converted|cancelled
  firstName     String
  lastName      String
  email         String
  phone         String
  company       String?
  channel       String      @default("email")
  title         String?
  notes         String?     // internal only, never printed on the PDF
  conditions    String?     // free text printed under the total
  lang          String      @default("fr") // fr|en|es
  validUntil    DateTime
  totalAmount   Int         @default(0)
  currency      String      @default("MAD")
  sentAt        DateTime?
  answeredAt    DateTime?
  answeredBy    String?     // client|admin
  clientMessage String?
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  convertedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         DevisItem[]
}

// One quote line: either a catalogue item (priced by the same engine as bookings)
// or a free line typed by the admin (transport, wedding setup, a discount…).
model DevisItem {
  id          String    @id @default(cuid())
  devisId     String
  devis       Devis     @relation(fields: [devisId], references: [id], onDelete: Cascade)
  kind        String    @default("catalog") // catalog|custom
  serviceType String    @default("suite")
  suiteId     String?
  suite       Suite?    @relation(fields: [suiteId], references: [id])
  activityId  String?
  activity    Activity? @relation(fields: [activityId], references: [id])
  dayPassId   String?
  dayPass     DayPass?  @relation(fields: [dayPassId], references: [id])
  label       String    @default("")
  description String?
  checkIn     DateTime?
  checkOut    DateTime?
  date        DateTime?
  quantity    Int       @default(1)
  guests      Int       @default(2)
  children    Int       @default(0)
  unitPrice   Int       @default(0) // custom lines; negative means a discount
  totalAmount Int       @default(0)
  currency    String    @default("MAD")
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
}
